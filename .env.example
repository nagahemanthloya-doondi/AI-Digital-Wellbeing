# LLM_PROVIDER_API_KEY: Optional API key for cloud LLM providers (Gemini, OpenAI, Anthropic, Groq, OpenRouter)
# used by the Aegis Notification Summary service when Cloud API mode is selected.
# Users configure this via the Secrets panel in the AI Studio UI.
LLM_PROVIDER_API_KEY=MY_LLM_PROVIDER_API_KEY
GEMINI_API_KEY=MY_GEMINI_API_KEY
OPENAI_API_KEY=MY_OPENAI_API_KEY
